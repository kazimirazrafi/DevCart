{
  "name": "@dtc/backend",
  "version": "0.0.1",
  "description": "DevCart backend — Medusa commerce API.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "seed": "medusa exec ./src/scripts/seed-all.ts",
    "seed-catalogue": "medusa exec ./src/scripts/seed-catalogue.ts",
    "reset-catalog": "medusa exec ./src/scripts/reset-catalog.ts",
    "refresh-catalogue": "medusa exec ./src/scripts/refresh-catalogue.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration:modules && pnpm run test:integration:http",
    "test:integration:http": "REDIS_URL= TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "REDIS_URL= TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "REDIS_URL= TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/caching": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@tanstack/react-query": "5.64.2",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/turndown": "^5.0.6",
    "ioredis": "^5.11.1",
    "marked": "^4.3.0",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "recharts": "^3.10.1",
    "turndown": "^7.2.4",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}