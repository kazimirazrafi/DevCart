# Copy to .env and fill in. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Matches the defaults in the repo's docker-compose.yml.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa-dtc-starter
DB_NAME=medusa-dtc-starter

# --- Redis ------------------------------------------------------------------
# The workflow engine (import/export) and the rate limiter both use it. With it
# set, rate limits are shared by every instance; without it both fall back to
# in-process state, which is fine locally and looser behind several instances.
REDIS_URL=redis://localhost:6379

# --- CORS -------------------------------------------------------------------
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# --- Secrets ----------------------------------------------------------------
# Generate strong random values for anything that is not local development.
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
# Signs the link that lets a guest open their own order without an account, so
# the order id alone (which is a URL) no longer reads it. At least 32
# characters, and the same value in the storefront's .env.local — the storefront
# mints the token after checkout and this side verifies it. Rotating it revokes
# every order link that has already been sent.
ORDER_ACCESS_SECRET=local-development-order-access-secret-change-me
# Keys the six-digit codes that prove a guest's email address is theirs, and
# the token a confirmation hands back so the cart can be completed. At least 32
# characters. Required: without it guest checkout refuses to issue a code rather
# than falling back to a value in the repository. Generate one for production
# (`openssl rand -hex 32`); rotating it only invalidates codes already sent and
# tokens already handed out.
EMAIL_VERIFICATION_SECRET=local-development-email-verification-secret-change-me

# --- Stripe (test mode) -----------------------------------------------------
# Required before Stripe can be used as a payment provider (feature K4).
# Test keys start with sk_test_ / pk_test_. Without STRIPE_API_KEY the backend
# does not register the provider at all (and still boots); the storefront's
# NEXT_PUBLIC_STRIPE_KEY must come from the same Stripe account. Re-run the seed
# afterwards so the region offers it. See docs/SETUP.md, "Stripe (test mode)".
STRIPE_API_KEY=
# Signing secret for the Stripe webhook Medusa serves at
# /hooks/payment/stripe_stripe (K7): from `stripe listen` locally, or from the
# endpoint in the Stripe dashboard in production. Without it every delivery
# fails verification and is ignored. See docs/SETUP.md, "Stripe webhooks".
STRIPE_WEBHOOK_SECRET=

# --- Google sign-in (A1) ---------------------------------------------------
# All three are required together: without GOOGLE_CLIENT_ID the backend does not
# register the provider at all (and still boots), and the storefront's sign-in
# page keeps working with email and password. Create the OAuth client in Google
# Cloud and allow-list GOOGLE_CALLBACK_URL as its redirect URI — that URL is the
# storefront route below. See docs/SETUP.md, "Google sign-in".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# --- Resend notifications ---------------------------------------------------
# Both are required before real email is sent (E1-E3). Without them the backend
# registers Medusa's local notification provider instead: notifications are
# stored and logged, nothing is delivered, and the backend still boots. When
# both are set, the store's own provider module (src/modules/notification-resend)
# takes the email channel and its templates are in that module's `templates/`.
RESEND_API_KEY=
# Must be a verified sender, e.g. "DevCart <orders@example.com>".
RESEND_FROM=
# Where the links in emails point. No country code: the storefront middleware
# adds the visitor's region. Change it when the storefront is deployed.
STOREFRONT_URL=http://localhost:8000
# The name the emails are signed with (falls back to "DevCart").
STORE_NAME=DevCart
# Test-only: point the provider at a local stub instead of api.resend.com.
# Leave empty in normal use.
RESEND_BASE_URL=

# --- Low-stock alerts (§5.5 C) ----------------------------------------------
# The scheduled job (src/jobs/low-stock-alert.ts) mails this address when a
# stock level is at or below the threshold. Leave it empty to switch the job
# off — a fresh clone then never mails anyone.
LOW_STOCK_ALERT_EMAIL=
# Warn at or below this many buyable units (stocked minus reserved). Default 5.
LOW_STOCK_THRESHOLD=5
# How long one level's alert counts as already sent. Default 24 (hours).
LOW_STOCK_ALERT_COOLDOWN_HOURS=24
# Cron for the check itself. Hourly by default; the cooldown, not this, is what
# limits how often the admin hears about the same product.
LOW_STOCK_ALERT_SCHEDULE=0 * * * *

# --- Search -----------------------------------------------------------------
# The project uses Medusa's built-in search API; these are unused unless
# Meilisearch is adopted. See ROADMAP.md "Standing notes".
MEILISEARCH_HOST=
MEILISEARCH_ADMIN_KEY=

# --- File storage ------------------------------------------------------------
# Product export/import (and admin media uploads) go through the file module.
# The local provider writes to apps/backend/static and serves the download from
# <MEDUSA_BACKEND_URL>/static, so this must be the origin a browser can reach:
# http://localhost:9000 locally, the public API origin in production.
MEDUSA_BACKEND_URL=http://localhost:9000

# --- S3-compatible storage --------------------------------------------------
# Unused while the local provider is configured (see medusa-config.ts). These
# are the variables to wire up if you move uploads to production storage
# (Cloudflare R2, AWS S3, MinIO).
S3_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
