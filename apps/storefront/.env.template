# Copy to .env.local and fill in. Never commit the real .env.local.

# Publishable API key for the Medusa backend. Required for the storefront to function.
# Learn how to create a publishable key: https://docs.medusajs.com/v2/resources/storefront-development/publishable-api-keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default region code to use for the storefront
NEXT_PUBLIC_DEFAULT_REGION=dk

# Base URL of the storefront. Canonical URLs, Open Graph URLs, sitemap.xml and
# robots.txt are built on it, so it must be the public origin the site is served
# from. Locally the dev server is http on port 8000; set the https domain in
# production.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Store name shown in the navigation, page titles and metadata
NEXT_PUBLIC_STORE_NAME=DevCart

# Stripe publishable key (test mode: pk_test_...). Required for card payments at
# checkout (feature K4) and must come from the same Stripe account as the
# backend's STRIPE_API_KEY. See docs/SETUP.md, "Stripe (test mode)".
NEXT_PUBLIC_STRIPE_KEY=

# Signs the token in the order confirmation link: a guest has no account, so
# this is what proves the link holder may read that order. At least 32
# characters, and exactly the backend's ORDER_ACCESS_SECRET — the backend
# verifies what this mints. Server-side only; never prefix it with NEXT_PUBLIC.
# See docs/SETUP.md, "Order links".
ORDER_ACCESS_SECRET=local-development-order-access-secret-change-me

# Search (unused: the project uses Medusa's built-in search API)
NEXT_PUBLIC_MEILISEARCH_HOST=
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=

# Medusa Cloud S3 bucket hostname (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_HOSTNAME=

# Medusa Cloud S3 bucket path (optional, only for Medusa Cloud deployments)
MEDUSA_CLOUD_S3_PATHNAME=

# Node environment (development, production, etc.)
NODE_ENV=development
