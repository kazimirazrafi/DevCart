{
  "name": "dtc-starter-monorepo",
  "description": "DevCart — monorepo for the Medusa backend and Next.js storefront.",
  "private": false,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "pnpm -r typecheck",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront",
    "lighthouse": "lhci autorun"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.5",
      "@types/react-dom": "19.0.5",
      "tsconfig-paths": "^4.2.0",
      "proxy-addr": ">=2.0.8"
    }
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@medusajs/eslint-plugin": "2.22.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.11.10"
  }
}
